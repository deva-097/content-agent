# Anthropic API
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Email (Gmail example — use App Password, not your account password)
# Generate at: https://myaccount.google.com/apppasswords
CONTENT_AGENT_SMTP_HOST=smtp.gmail.com
CONTENT_AGENT_SMTP_PORT=465
CONTENT_AGENT_SMTP_USERNAME=your.email@gmail.com
CONTENT_AGENT_SMTP_PASSWORD=your-app-password
CONTENT_AGENT_EMAIL_FROM=your.email@gmail.com
CONTENT_AGENT_EMAIL_TO=your.email@gmail.com
CONTENT_AGENT_SMTP_DRY_RUN=false
